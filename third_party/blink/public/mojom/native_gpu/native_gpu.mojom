module blink.mojom;
import "gpu/ipc/common/native_gpu.mojom";
import "gpu/ipc/common/sync_token.mojom";
import "third_party/blink/public/mojom/permissions/permission_status.mojom";

// Document-scoped browser broker. No native GPU handles cross into a renderer.
interface NativeGpuService {
  QueryCapabilities() => (bool native_cuda, bool rtx);
  RequestPermission() => (PermissionStatus status, string error);
  QueryPermission() => (PermissionStatus status);
  Execute(string operation, string payload) => (bool success, string response);
  CreateDLSSFrame(gpu.mojom.NativeGpuFrameDescriptor descriptor)
      => (uint32 frame_id, string error);
  ProcessDLSSFrame(uint32 frame_id, gpu.mojom.SyncToken ready, string options)
      => (bool success, string error);
  DestroyDLSSFrame(uint32 frame_id);
  Close();
};
