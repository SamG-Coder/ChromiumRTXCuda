[Exposed=Window, SecureContext, RuntimeEnabled=NativeGpu]
interface NativeGPUFrame {
  readonly attribute GPUTexture color;
  readonly attribute GPUTexture depth;
  readonly attribute GPUTexture motionVectors;
  readonly attribute GPUTexture output;
  [CallWith=ScriptState, RaisesException] Promise<GPUTexture> process(DOMString options);
  undefined destroy();
};
