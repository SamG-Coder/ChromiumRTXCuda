[Exposed=Window, SecureContext, RuntimeEnabled=NativeGpu]
interface NativeGPU {
  [CallWith=ScriptState, RaisesException] Promise<boolean> SupportsNativeCuda();
  [CallWith=ScriptState, RaisesException] Promise<boolean> SupportsRTX();
  [CallWith=ScriptState, RaisesException] Promise<DOMString> requestPermission();
  [CallWith=ScriptState, RaisesException] Promise<DOMString> queryPermission();
  // Transport used by the cuda-webshader-compatible GpuRuntime module.
  [CallWith=ScriptState, RaisesException] Promise<DOMString> execute(DOMString operation, DOMString payload);
  [CallWith=ScriptState, RaisesException] Promise<NativeGPUFrame> createDLSSFrame(
      GPUDevice device, [EnforceRange] unsigned long width, [EnforceRange] unsigned long height,
      [EnforceRange] unsigned long outputWidth, [EnforceRange] unsigned long outputHeight,
      DOMString quality, boolean depthInverted);
  undefined close();
  [CallWith=ScriptState, RaisesException] Promise<DOMString> getInteropCapabilities(GPUDevice device);
  [CallWith=ScriptState, RaisesException] Promise<NativeGPUResource> createSharedBuffer(
      GPUDevice device, [EnforceRange] unsigned long long size, [EnforceRange] unsigned long usage);
  [CallWith=ScriptState, RaisesException] Promise<NativeGPUResource> createSharedTexture(
      GPUDevice device, [EnforceRange] unsigned long width, [EnforceRange] unsigned long height,
      DOMString format, [EnforceRange] unsigned long usage);
  [CallWith=ScriptState, RaisesException] Promise<NativeGPUResource> createCanvasSurface(
      GPUDevice device, [EnforceRange] unsigned long width, [EnforceRange] unsigned long height);
  [CallWith=ScriptState, RaisesException] Promise<DOMString> dispatchShared(
      sequence<NativeGPUResource> resources, DOMString jobs);
};
