[Exposed=Window, SecureContext, RuntimeEnabled=NativeGpu]
interface NativeGPUResource {
  readonly attribute GPUBuffer? buffer;
  readonly attribute GPUTexture? texture;
  // Opaque document identifier, never a native address or OS handle.
  readonly attribute unsigned long id;
  readonly attribute boolean available;
  [RaisesException] undefined present(GPUCanvasContext context);
  undefined destroy();
};
