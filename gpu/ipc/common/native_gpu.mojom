module gpu.mojom;
import "gpu/ipc/common/sync_token.mojom";
import "gpu/ipc/common/mailbox.mojom";
import "mojo/public/mojom/base/unguessable_token.mojom";

// Renderer-visible identifiers refer only to objects in that renderer's wire
// connection. Operating system handles travel exclusively between trusted
// browser and GPU processes.
struct NativeGpuWireTexture {
  uint32 id;
  uint32 generation;
};
struct NativeGpuFrameDescriptor {
  SyncToken ready;
  uint32 device_id;
  uint32 device_generation;
  array<NativeGpuWireTexture, 4> textures;
  uint32 width;
  uint32 height;
  uint32 output_width;
  uint32 output_height;
  string quality;
  bool depth_inverted;
};
// Resources are created explicitly for sharing. Existing arbitrary WebGPU
// objects and canvas swap-chain textures cannot be imported.
struct NativeGpuResourceDescriptor {
  SyncToken ready;
  uint32 device_id;
  uint32 device_generation;
  uint32 id;
  uint32 generation;
  Mailbox? canvas_mailbox;
  bool texture;
  uint64 size;
  uint32 usage;
  uint32 width;
  uint32 height;
  string format;
};
enum NativeGpuTextureAction {
  kCreate, kRelease, kAcquire, kDestroy,
  kProbeInterop, kCreateResource, kReleaseResources, kAcquireResources,
  kDestroyResource
};
struct NativeGpuTextureCommand {
  NativeGpuTextureAction action;
  mojo_base.mojom.UnguessableToken frame;
  SyncToken ready;
  NativeGpuFrameDescriptor? descriptor;
  array<handle<platform>> handles;
  uint32 adapter_luid_low;
  int32 adapter_luid_high;
  NativeGpuResourceDescriptor? resource;
  array<mojo_base.mojom.UnguessableToken> resources;
  uint64 fence_value;
};
struct NativeGpuTextureResult {
  bool success;
  string error;
  array<handle<platform>> fences;
  array<uint64> fence_values;
  // Trusted GPU-to-browser completion events; never sent to the renderer.
  array<handle<platform>> completion_events;
  uint32 adapter_luid_low;
  int32 adapter_luid_high;
};
